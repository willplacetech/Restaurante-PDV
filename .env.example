# Example env — copy to .env and fill values. Never commit secrets.

# MongoDB connection string
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/pdv-restaurante

# Admin credentials (default admin/admin1234)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# Frontend URL for CORS (comma-separated if multiple)
FRONTEND_URL=https://pdv-restaurante-demo.onrender.com